# ==============================================================================
# Spendly AI - Environment variable TEMPLATE
#
# This file IS committed to git. It documents which variables the project
# needs, using placeholder values only. NEVER put a real secret here.
#
# Setup:
#   1. Copy this file to `.env`   (PowerShell: Copy-Item .env.example .env)
#   2. Replace the placeholder values
#   3. `.env` is gitignored and must stay that way
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL container (consumed by docker-compose.yml)
# ------------------------------------------------------------------------------
POSTGRES_USER=spendly
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=spendly

# Host port for the database. 5433 (not the default 5432) because a native
# PostgreSQL install may already occupy 5432 on the host machine.
POSTGRES_PORT=5433

# ------------------------------------------------------------------------------
# Backend application
# ------------------------------------------------------------------------------
# SQLAlchemy connection URL.
# Dialect `postgresql+asyncpg` selects the asyncpg driver. psycopg's async mode
# refuses to run on Windows' ProactorEventLoop, which uvicorn installs; asyncpg
# works on every platform.
# Host is localhost:5433 because the app runs on the host and reaches the
# database through the container's published port. When the API itself moves
# into a container, this becomes `db:5432` (the compose service name).
DATABASE_URL=postgresql+asyncpg://spendly:replace_with_a_local_password@localhost:5433/spendly

# Controls error verbosity, docs exposure, and reload behaviour.
# One of: local | test | production
ENVIRONMENT=local

# ------------------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------------------
# Signs and verifies every JWT. There is deliberately NO DEFAULT in the code:
# a fallback in a public repository would be a published signing key, letting
# anyone mint a token for any user.
#
# Must be at least 32 characters; the app refuses to start otherwise.
# Generate your own - never reuse this placeholder, and never share a key
# between environments:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace_me_with_at_least_32_random_characters

# How long an access token stays valid. Because access tokens carry no
# server-side state, they CANNOT be revoked - so this value is the window in
# which a stolen token remains usable.
ACCESS_TOKEN_EXPIRE_MINUTES=30
